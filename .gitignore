# Nim
nimcache/
nimblecache/
*.exe
*.out
*.o
*.so
*.dylib

# Binaries (in root only, not src/chapulin/)
/chapulin
/chapulin_gui
/nimtftp
/nimtftp_gui

# Test artifacts
test-files/large.bin
/tmp/
# RFC verification-harness-v2 C3: raw tcpdump-sidecar capture output (a
# runtime artifact, not a source file -- the HARVESTED seeds it produces
# via tests/interopcapture.nim land in tests/corpus/, which IS committed).
/interop-captures/
# Compiled test binaries (nim c -r artifacts, no extension); keep the sources.
tests/t_*
!tests/t_*.nim
# ...and their hand-authored nim config sidecars (e.g. t_symex*.nim.cfg supply the
# z3 include path; without this negation `tests/t_*` ignores them and the symex
# suites silently break on a fresh clone — RFC verification-harness-v2 B1/B2).
!tests/t_*.nim.cfg

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# milpa (dependency resolver) — generated outputs.
# milpa.kdl (manifest) and milpa.lock (lockfile) ARE committed.
_deps/
# Anchored to the repo root: the unanchored form also matched
# tests/nim.cfg, a hand-authored, committed file (RFC verification-harness
# D2 — supplies -d:chapulinFuzz to every test compiled from tests/), and
# would have silently dropped it from every commit with no error.
/nim.cfg
.milpa-cache/

# Claude
.claude/
