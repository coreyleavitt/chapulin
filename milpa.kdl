// milpa manifest for chapulin — github.com/coreyleavitt/milpa
// Resolves deps and emits nim.cfg; bypasses nimble's SAT solver for URL deps.

name "chapulin"

src_dir "src"

kind "application"

deps {
    "NiGui" git=(url)"https://github.com/coreyleavitt/NiGui.git" ref="master"
}

// Test-only: property-based testing of the pure layers (protocol codec,
// option parsing, validatePath, tftp_uri). Not a runtime dependency — milpa
// resolves the root's dev-deps but never a transitive dep's dev-deps.
dev-deps {
    // nelli (the property-based testing engine formerly named `proptest`;
    // renamed upstream, absorbed here — every test `import proptest` is now
    // `import nelli`). Pinned by git TAG. v0.5.3 is the current stack; see
    // docs/proptest-findings.md for the per-pin symex re-evaluations. Switch
    // to the registry form `"nelli" "==0.5.3"` once the live tianguis index
    // (coreyleavitt/tianguis/main/index.kdl) carries it.
    "nelli" git=(url)"https://github.com/coreyleavitt/nelli.git" ref="v0.5.3"
    // Root pins to DISAMBIGUATE from same-named tianguis registry packages
    // (milpa's dependency-confusion guard, 2026-08-05): the registry's "z3" is
    // github.com/zevv/z3 — chapulin needs coreyleavitt/nim-z3, a DISTINCT fork —
    // so it must be pinned explicitly at the root, not left transitive. softlink
    // (our own) is pinned to v0.11.1, the version nim-z3 main now requires.
    // (Supersedes the 2026-08-04 "shims are redundant" removal: redundant under
    // pure-git resolution, but required once the deps landed in tianguis.)
    "z3" git=(url)"https://github.com/coreyleavitt/nim-z3.git" ref="main"
    "softlink" git=(url)"https://github.com/coreyleavitt/softlink.git" ref="v0.11.1"
}
